{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "FindFit design tokens — Chic Minimalista direction. Warm neutral palette (pure white, near-black #171614, champagne #c9b6a1), DM Sans typeface, zero border-radius throughout. Edit only this file — never hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":           { "$value": "#ffffff",  "$description": "Page background — pure white across all screens." },
      "foreground":           { "$value": "#171614",  "$description": "Default text — near-black, warm undertone." },
      "card":                 { "$value": "#f5f2ef",  "$description": "Product card image placeholder background." },
      "cardForeground":       { "$value": "#171614" },
      "popover":              { "$value": "#ffffff" },
      "popoverForeground":    { "$value": "#171614" },
      "primary":              { "$value": "#171614",  "$description": "Primary brand color. CTA buttons, wordmark, emphasis." },
      "primaryForeground":    { "$value": "#ffffff" },
      "secondary":            { "$value": "#faf9f7",  "$description": "Off-white surface — upload area, secondary panels." },
      "secondaryForeground":  { "$value": "#171614" },
      "muted":                { "$value": "#eee9e4",  "$description": "Muted surface — image tint overlay, nav ghost backgrounds." },
      "mutedForeground":      { "$value": "#9a938d",  "$description": "Muted text — store name, collection, metadata." },
      "accent":               { "$value": "#c9b6a1",  "$description": "Champagne accent — badge text, wordmark decorative line." },
      "accentForeground":     { "$value": "#171614" },
      "destructive":          { "$value": "#b91c1c" },
      "destructiveForeground":{ "$value": "#ffffff" },
      "border":               { "$value": "#d9d4cf",  "$description": "Default border — filter chips (inactive), button outline." },
      "input":                { "$value": "#20201e",  "$description": "Strong border — upload area dashed outline." },
      "ring":                 { "$value": "#c9b6a1",  "$description": "Focus ring — champagne, subtle." },
      "chart1":               { "$value": "#171614" },
      "chart2":               { "$value": "#9a938d" },
      "chart3":               { "$value": "#c9b6a1" },
      "chart4":               { "$value": "#77716b" },
      "chart5":               { "$value": "#e7e2de" },
      "sidebar":              { "$value": "#faf9f7" },
      "sidebarForeground":    { "$value": "#171614" },
      "sidebarBorder":        { "$value": "#e7e2de" },
      "sidebarPrimary":       { "$value": "#171614" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent":        { "$value": "#f5f2ef" },
      "sidebarAccentForeground": { "$value": "#171614" },
      "sidebarRing":          { "$value": "#c9b6a1" }
    },
    "dark": {
      "background":           { "$value": "#0e0d0c",  "$description": "Dark page background — very warm near-black." },
      "foreground":           { "$value": "#f0ede9",  "$description": "Dark default text — warm off-white." },
      "card":                 { "$value": "#1a1917" },
      "cardForeground":       { "$value": "#f0ede9" },
      "popover":              { "$value": "#1a1917" },
      "popoverForeground":    { "$value": "#f0ede9" },
      "primary":              { "$value": "#f0ede9",  "$description": "Inverted primary — warm off-white on dark." },
      "primaryForeground":    { "$value": "#0e0d0c" },
      "secondary":            { "$value": "#262421" },
      "secondaryForeground":  { "$value": "#f0ede9" },
      "muted":                { "$value": "#201f1d" },
      "mutedForeground":      { "$value": "#9a938d" },
      "accent":               { "$value": "#c9b6a1",  "$description": "Champagne stays consistent across modes." },
      "accentForeground":     { "$value": "#0e0d0c" },
      "destructive":          { "$value": "#ef4444" },
      "destructiveForeground":{ "$value": "#ffffff" },
      "border":               { "$value": "#2e2c2a" },
      "input":                { "$value": "#3d3b38" },
      "ring":                 { "$value": "#c9b6a1" },
      "chart1":               { "$value": "#f0ede9" },
      "chart2":               { "$value": "#9a938d" },
      "chart3":               { "$value": "#c9b6a1" },
      "chart4":               { "$value": "#77716b" },
      "chart5":               { "$value": "#2e2c2a" },
      "sidebar":              { "$value": "#0e0d0c" },
      "sidebarForeground":    { "$value": "#f0ede9" },
      "sidebarBorder":        { "$value": "#2e2c2a" },
      "sidebarPrimary":       { "$value": "#c9b6a1" },
      "sidebarPrimaryForeground": { "$value": "#0e0d0c" },
      "sidebarAccent":        { "$value": "#1a1917" },
      "sidebarAccentForeground": { "$value": "#f0ede9" },
      "sidebarRing":          { "$value": "#c9b6a1" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["DM Sans", "sans-serif"], "$description": "The sole typeface across all FindFit UI." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["ui-monospace", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Zero radius throughout — square corners reinforce the editorial, non-startup aesthetic."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step (4px). Components multiply this."
    }
  }
}
